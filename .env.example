# Variables de entorno para EasyPanel
# Copia estos nombres en la sección "Environment" de tu App y pon tus valores reales.

# Contraseña del panel de administración (/admin.html)
ADMIN_PASSWORD=pon-aqui-una-clave-fuerte

# Secreto de sesiones: una cadena larga y aleatoria (mientras más random, mejor)
SESSION_SECRET=cambia-esto-por-una-cadena-larga-aleatoria

# Puerto interno del contenedor (EasyPanel lo mapea al dominio)
PORT=3000

# Carpeta de datos persistente: DEBE coincidir con el volumen montado en EasyPanel
DATA_DIR=/app/data

# ---- Análisis de fotos con IA (opcional) ----
# Obtén API keys gratis en https://aistudio.google.com/apikey
# Si la defines, la app analiza las fotos automáticamente. Si la dejas vacía, se desactiva.
# Para VARIAS cuentas, usa una variable por clave (recomendado en EasyPanel).
# La app rota automáticamente a la siguiente cuando una se agota o falla:
#   GEMINI_API_KEY=AIzaClaveVieja
#   GEMINI_API_KEY_1=AIzaCuenta1
#   GEMINI_API_KEY_2=AIzaCuenta2
#   ... (hasta GEMINI_API_KEY_30)
# (También sirve una sola: GEMINI_API_KEY=AIza..., o varias por coma.)
GEMINI_API_KEY=
# Modelo (opcional, por defecto gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash
# Pausa entre llamadas en ms (opcional, para respetar el límite del free tier)
AI_DELAY_MS=4500

# ---- Integración con el sistema de asistencias (opcional) ----
# Clave compartida para el endpoint /api/estado-sucursal. Debe ser IGUAL a
# STAND_API_KEY en el sistema de asistencias. Si se deja vacía, el endpoint se apaga.
INTEGRATION_KEY=
